# Build output. Build out of source in build/ (see README).
/build/
build-*/

# In-source qmake builds (if you build next to the sources anyway)
Makefile
Makefile.Debug
Makefile.Release
object_script.*
debug/
release/
*.o
*.obj
moc_*
qrc_*.cpp
ui_*.h
.qmake.stash
/executable/
*.app/

# Compiled binaries. The prebuilt Dreamcast SDK bits and tools are committed
# on purpose, so keep those directories tracked.
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.elf
!/libGyro/lib/**
!/libGyro/tools/**

# Generated Spine .pri from qmake
/Spine/qtcreator/Spine/*.pri

# Runtime logs and generated files
*.log
lua_debug.txt
gamma_debug.txt
gamma_args.txt
toolkit_debug.txt
shadowRenderPasses
/Project/
/Docs/Documentation/
/out/

# IDE / per-user settings
*.pro.user
*.pro.user.*
CMakeLists.txt.user
*.swp
*~

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
